# Daily digests are generated artifacts, not source. They stay on disk, out of git.
/output/*
!/output/test/

# The ledger is the exception and MUST stay tracked: the automation checks out a
# fresh worktree from git on every run, so an ignored ledger means every run starts
# with an empty blocklist and the digest repeats itself. Ledger lives in /ledger/.

# Your working config: machine paths, automation id, your stack. Never public.
# Commit config/digest.json (the template), not this. See config/digest.example.json.
/config/digest.local.json

# Local scratch
*.tmp
*.bak
.DS_Store
Thumbs.db

# Python bytecode (tools/render_assets.py)
__pycache__/
*.py[cod]